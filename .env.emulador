# "npm run dev:emulador": usa o Firebase de teste que roda no próprio computador
VITE_USAR_EMULADOR=true
VITE_FIREBASE_API_KEY=chave-de-teste
VITE_FIREBASE_AUTH_DOMAIN=demo-presenca.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-presenca
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=demo
